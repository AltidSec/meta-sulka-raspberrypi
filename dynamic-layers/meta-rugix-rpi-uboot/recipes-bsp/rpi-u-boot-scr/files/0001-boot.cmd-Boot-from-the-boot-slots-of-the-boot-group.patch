From 6a20c93eb80abc888700348430c659d153939048 Mon Sep 17 00:00:00 2001
From: ejaaskel <esa.jaaskela@suomi24.fi>
Date: Thu, 12 Nov 2026 22:38:51 +0200
Subject: [PATCH] boot.cmd: Boot from the boot slots of the boot group

Load the kernel from the boot slot of the boot group instead of the
system slot, and pass the system slot as the root:

  Boot group a: boot slot mmcblk0p2, system slot mmcblk0p4
  Boot group b: boot slot mmcblk0p3, system slot mmcblk0p5

The root file system is protected with dm-verity, and its root hash is
in the initramfs bundled with the kernel, so the kernel can't be stored
in the file system it verifies. Rugix sets rugix_bootpart to 2 for the
boot group a and to 3 for the boot group b.

Rugix before 1.3.0 can't match the dm-verity device to a system slot,
so pass the booted group in rugix.boot_group. Rugix 1.3.0 and newer can
also find it through the backing devices of the device mapper device.

Upstream-Status: Inappropriate [Sulka specific]
---
 boot.cmd.in | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/boot.cmd.in b/boot.cmd.in
index 078c508..6939ec5 100644
--- a/boot.cmd.in
+++ b/boot.cmd.in
@@ -9,20 +9,24 @@ echo "Bootpart: " ${rugix_bootpart}
 if test "${rugix_boot_spare}" = "1"; then
   if test "${rugix_bootpart}" = "3"; then
     setenv rugix_boot_dev "mmc 0:2"
-    setenv rugix_root "/dev/mmcblk0p2"
+    setenv rugix_root "/dev/mmcblk0p4"
+    setenv rugix_group a
   else
     setenv rugix_boot_dev "mmc 0:3"
-    setenv rugix_root "/dev/mmcblk0p3"
+    setenv rugix_root "/dev/mmcblk0p5"
+    setenv rugix_group b
   fi
   setenv rugix_boot_spare 0
   saveenv
 else
   if test "${rugix_bootpart}" = "3"; then
     setenv rugix_boot_dev "mmc 0:3"
-    setenv rugix_root "/dev/mmcblk0p3"
+    setenv rugix_root "/dev/mmcblk0p5"
+    setenv rugix_group b
   else
     setenv rugix_boot_dev "mmc 0:2"
-    setenv rugix_root "/dev/mmcblk0p2"
+    setenv rugix_root "/dev/mmcblk0p4"
+    setenv rugix_group a
   fi
 fi
 
@@ -31,6 +35,6 @@ echo "Bootdev: " ${rugix_boot_dev}
 # Initialize the UBoot environment on first boot.
 if test ! -e mmc 0:1 uboot.env; then saveenv; fi;
 
-setenv bootargs "${bootargs} root=${rugix_root} init=/usr/bin/rugix-ctrl ro"
-load ${rugix_boot_dev} ${kernel_addr_r} boot/@@KERNEL_IMAGETYPE@@
+setenv bootargs "${bootargs} root=${rugix_root} rugix.boot_group=${rugix_group} init=/usr/bin/rugix-ctrl ro"
+load ${rugix_boot_dev} ${kernel_addr_r} @@KERNEL_IMAGETYPE@@
 @@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}
